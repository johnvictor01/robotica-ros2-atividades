<?xml version="1.0"?>

<robot name="meu_robo">

  <!-- Corpo -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="1.0 0.6 0.3"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="1.0 0.6 0.3"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <inertia
        ixx="0.1"
        ixy="0.0"
        ixz="0.0"
        iyy="0.1"
        iyz="0.0"
        izz="0.1"/>
    </inertial>
  </link>

  <!-- Roda esquerda -->
  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
    </visual>
  </link>

  <!-- Roda direita -->
  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
    </visual>
  </link>

  <!-- Junta da roda esquerda -->
  <joint name="left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.35 -0.15" rpy="1.5708 0 0"/>
  </joint>

  <!-- Junta da roda direita -->
  <joint name="right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.35 -0.15" rpy="1.5708 0 0"/>
  </joint>

</robot>
