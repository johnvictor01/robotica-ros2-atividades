<?xml version="1.0"?>
<sdf version="1.6">
  <world name="tri_x_asphalt">
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.42 0.45 0.50 1</ambient>
      <background>0.70 0.78 0.88 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    <include><uri>model://sun</uri></include>

    <!-- Asfalto texturizado com os materiais que acompanham o Gazebo Classic. -->
    <model name="asphalt_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="asphalt_visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Road</name>
            </script>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Centro do waypoint e anel pontilhado: o controlador troca de alvo a 0.10 m. -->
